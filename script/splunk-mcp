#!/usr/bin/env bash

set -euo pipefail

readonly IMAGE="ghcr.io/github/splunk-mcp-server:latest"
readonly TOKEN_REF="op://Employee/Splunk token/password"
readonly DOCKER_TIMEOUT=90

# Copilot does not expand ${...} in MCP env values, it passes the literal string
# through, and a literal is non-empty enough to defeat the check below. A real
# exported token is inherited from the environment anyway, so treat anything
# still wearing placeholder syntax as unset.
if [[ "${SPLUNK_BEARER_TOKEN:-}" == '${'*'}' ]]; then
  SPLUNK_BEARER_TOKEN=""
fi

if [[ -z "${SPLUNK_BEARER_TOKEN:-}" ]]; then
  if ! SPLUNK_BEARER_TOKEN="$(op read "$TOKEN_REF" 2>/dev/null)"; then
    echo "No Splunk token. Store one at $TOKEN_REF or export SPLUNK_BEARER_TOKEN." >&2
    exit 1
  fi
  export SPLUNK_BEARER_TOKEN
fi

if ! docker info >/dev/null 2>&1; then
  if [[ ! -d /Applications/Docker.app ]]; then
    echo "Docker is not running. Start the Docker daemon and retry." >&2
    exit 1
  fi

  echo "Starting Docker Desktop, waiting up to ${DOCKER_TIMEOUT}s..." >&2
  open -ga Docker

  for ((i = 0; i < DOCKER_TIMEOUT; i++)); do
    docker info >/dev/null 2>&1 && break
    sleep 1
  done

  if ! docker info >/dev/null 2>&1; then
    echo "Docker did not become ready in ${DOCKER_TIMEOUT}s. Start Docker Desktop and retry." >&2
    exit 1
  fi
fi

# The macOS app does not put its CLI on PATH.
tailscale_bin="$(command -v tailscale || echo /Applications/Tailscale.app/Contents/MacOS/Tailscale)"
if [[ ! -x "$tailscale_bin" ]]; then
  echo "Tailscale is not installed." >&2
  if [[ -d "/Applications/Self Service.app" ]]; then
    echo "Install it from Jamf Self Service: open -a 'Self Service'" >&2
  fi
  exit 1
fi

if ! "$tailscale_bin" status >/dev/null 2>&1; then
  echo "Tailscale is not connected. Run 'tailscale up' and retry." >&2
  exit 1
fi

export SPLUNK_HOST="${SPLUNK_HOST:-splunkazure-api-azure-eastus.octoca.ts.net}"
export SPLUNK_PORT=443
export SPLUNK_SCHEME=https
export VERIFY_SSL=true
export FASTMCP_LOG_LEVEL=INFO

docker_args=(run -i --rm)
if [[ -n "${CODESPACES:-}" ]]; then
  docker_args+=(--dns=100.100.100.100)
fi

exec docker "${docker_args[@]}" \
  -e SPLUNK_HOST \
  -e SPLUNK_PORT \
  -e SPLUNK_BEARER_TOKEN \
  -e SPLUNK_SCHEME \
  -e VERIFY_SSL \
  -e FASTMCP_LOG_LEVEL \
  "$IMAGE"
