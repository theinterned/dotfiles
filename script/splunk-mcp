#!/usr/bin/env bash

set -euo pipefail

readonly IMAGE="ghcr.io/github/splunk-mcp-server:latest"
readonly TOKEN_REF="op://Employee/Splunk token/password"

if [[ -z "${SPLUNK_BEARER_TOKEN:-}" ]]; then
  if ! SPLUNK_BEARER_TOKEN="$(op read "$TOKEN_REF" 2>/dev/null)"; then
    echo "No Splunk token. Store one at $TOKEN_REF or export SPLUNK_BEARER_TOKEN." >&2
    exit 1
  fi
  export SPLUNK_BEARER_TOKEN
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker is not running. Start Docker Desktop and retry." >&2
  exit 1
fi

# The macOS app does not put its CLI on PATH.
tailscale_bin="$(command -v tailscale || echo /Applications/Tailscale.app/Contents/MacOS/Tailscale)"
if ! "$tailscale_bin" status >/dev/null 2>&1; then
  echo "Tailscale is not connected. Run 'tailscale up' and retry." >&2
  exit 1
fi

export SPLUNK_HOST="${SPLUNK_HOST:-splunkazure-api-azure-eastus.octoca.ts.net}"
export SPLUNK_PORT=443
export SPLUNK_SCHEME=https
export VERIFY_SSL=true
export FASTMCP_LOG_LEVEL=INFO

docker_args=(run -i --rm)
if [[ -n "${CODESPACES:-}" ]]; then
  docker_args+=(--dns=100.100.100.100)
fi

exec docker "${docker_args[@]}" \
  -e SPLUNK_HOST \
  -e SPLUNK_PORT \
  -e SPLUNK_BEARER_TOKEN \
  -e SPLUNK_SCHEME \
  -e VERIFY_SSL \
  -e FASTMCP_LOG_LEVEL \
  "$IMAGE"
