#!/usr/bin/env bash

set -euo pipefail

readonly IMAGE="ghcr.io/github/splunk-mcp-server:latest"
readonly TOKEN_REF="op://Employee/Splunk token/password"
readonly DOCKER_TIMEOUT=90
readonly KEYCHAIN_SERVICE="splunk-mcp-token"
readonly KEYCHAIN_ACCOUNT="${USER:-$(id -un)}"
# Splunk issues 90 day tokens. Recommend renewal once a week is left.
readonly REFRESH_MARGIN=$((7 * 24 * 60 * 60))
NOTIFY=false

# Decode expiry locally; Splunk still verifies the token's signature.
token_lifetime() {
  printf '%s' "$1" | python3 -c '
import base64
import json
import re
import sys
import time

try:
    parts = sys.stdin.read().split(".")
    if len(parts) != 3 or any(not re.fullmatch(r"[A-Za-z0-9_-]+", p) for p in parts):
        raise ValueError()
    payload = base64.b64decode(parts[1] + "=" * (-len(parts[1]) % 4),
                              altchars=b"-_", validate=True)
    exp = json.loads(payload)["exp"]
    if type(exp) is not int or not 0 < exp <= 2**63 - 1:
        raise ValueError()
    print(exp - int(time.time()))
except (ValueError, KeyError, TypeError):
    sys.exit(1)
'
}

token_validate() {
  local left
  if ! left="$(token_lifetime "$1")"; then
    echo "Splunk token is malformed or has no valid JWT expiry." >&2
    return 1
  fi
  if ((left <= 0)); then
    echo "Splunk token has expired." >&2
    return 1
  fi
  if ((left <= REFRESH_MARGIN)); then
    echo "Splunk token expires within seven days." >&2
    token_help
    notify "Splunk token expires within seven days."
  fi
}

# MCP stderr is easy to miss, so normal startup also shows a desktop alert.
# Notification output must stay off stdout, which carries the MCP protocol.
notify() {
  [[ "${NOTIFY:-}" == true ]] || return 0
  command -v osascript >/dev/null 2>&1 || return 0
  osascript \
    -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title "Splunk MCP" subtitle (item 1 of argv)' \
    -e 'end run' \
    "$1" "Refresh: bash ~/.dotfiles/script/splunk-mcp --refresh-token" \
    >/dev/null 2>&1 || true
}

token_help() {
  echo "Refresh the cache: bash ~/.dotfiles/script/splunk-mcp --refresh-token" >&2
  echo "If the 1Password copy is expired or missing, create or rotate the token in Splunk (https://splunk.githubapp.com) and update $TOKEN_REF first. Reading an expired token does not renew it." >&2
  echo "In Codespaces, update the SPLUNK_BEARER_TOKEN secret and restart the Codespace." >&2
}

keychain_read() {
  security find-generic-password -w -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" 2>/dev/null
}

# -U replaces any existing item. With -w as the final argument, security prompts
# twice on stdin, keeping the token out of its process arguments.
keychain_write() {
  printf '%s\n%s\n' "$1" "$1" | security add-generic-password -U \
    -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" \
    -w >/dev/null 2>&1
}

refresh_token() {
  if ! command -v op >/dev/null 2>&1; then
    echo "Token refresh requires the 1Password CLI (op). Install it and retry." >&2
    token_help
    return 1
  fi
  if ! SPLUNK_BEARER_TOKEN="$(op read "$TOKEN_REF" 2>/dev/null)"; then
    echo "Could not read the Splunk token from 1Password. Unlock 1Password, authorize the read, and check $TOKEN_REF." >&2
    token_help
    return 1
  fi
  if ! token_validate "$SPLUNK_BEARER_TOKEN"; then
    token_help
    return 1
  fi
  if ! keychain_write "$SPLUNK_BEARER_TOKEN"; then
    echo "Could not cache the Splunk token in macOS Keychain. Check Keychain access; until caching succeeds, later starts may prompt again." >&2
    token_help
    return 1
  fi
}

tailscale_path() {
  local path
  path="$(type -P tailscale || true)"
  printf '%s\n' "${path:-/Applications/Tailscale.app/Contents/MacOS/Tailscale}"
}

case "${1:-}" in
  "") [[ $# == 0 ]] || { echo "Usage: $0 [--refresh-token]" >&2; exit 2; } ;;
  --refresh-token) [[ $# == 1 ]] || { echo "Usage: $0 [--refresh-token]" >&2; exit 2; } ;;
  *) echo "Usage: $0 [--refresh-token]" >&2; exit 2 ;;
esac

if ! command -v python3 >/dev/null 2>&1; then
  echo "Splunk token validation requires python3. Install it and retry." >&2
  exit 1
fi

if [[ "${1:-}" == --refresh-token ]]; then
  if ! command -v security >/dev/null 2>&1; then
    echo "Token refresh requires macOS Keychain (security). In Codespaces, update the SPLUNK_BEARER_TOKEN secret instead." >&2
    exit 1
  fi
  refresh_token || exit 1
  echo "Splunk token refreshed in macOS Keychain. No services started." >&2
  exit 0
fi

# Copilot does not expand ${...} in MCP env values, it passes the literal string
# through, and a literal is non-empty enough to defeat the check below. A real
# exported token is inherited from the environment anyway, so treat anything
# still wearing placeholder syntax as unset.
if [[ "${SPLUNK_BEARER_TOKEN:-}" == '${'*'}' ]]; then
  SPLUNK_BEARER_TOKEN=""
fi

NOTIFY=true
if [[ -z "${SPLUNK_BEARER_TOKEN:-}" ]]; then
  if ! command -v security >/dev/null 2>&1; then
    echo "No inherited SPLUNK_BEARER_TOKEN and macOS Keychain is unavailable." >&2
    token_help
    exit 1
  fi
  if ! SPLUNK_BEARER_TOKEN="$(keychain_read)"; then
    echo "Splunk token cache is missing or unreadable. Check Keychain access." >&2
    needs_refresh=true
  elif ! token_validate "$SPLUNK_BEARER_TOKEN"; then
    echo "Splunk token cache is malformed or expired." >&2
    needs_refresh=true
  else
    needs_refresh=false
  fi
  if [[ "$needs_refresh" == true ]]; then
    echo "Falling back to 1Password once; this may request approval. A valid token will be cached to avoid prompts on later starts." >&2
    token_help
    notify "Cached token unusable; asking 1Password."
    if ! refresh_token; then
      notify "Splunk token refresh failed. Rotate it if expired."
      exit 1
    fi
  fi
  unset needs_refresh
elif ! token_validate "$SPLUNK_BEARER_TOKEN"; then
  token_help
  exit 1
fi
export SPLUNK_BEARER_TOKEN

if ! docker info >/dev/null 2>&1; then
  if [[ ! -d /Applications/Docker.app ]]; then
    echo "Docker is not running. Start the Docker daemon and retry." >&2
    exit 1
  fi

  echo "Starting Docker Desktop, waiting up to ${DOCKER_TIMEOUT}s..." >&2
  open -ga Docker

  for ((i = 0; i < DOCKER_TIMEOUT; i++)); do
    docker info >/dev/null 2>&1 && break
    sleep 1
  done

  if ! docker info >/dev/null 2>&1; then
    echo "Docker did not become ready in ${DOCKER_TIMEOUT}s. Start Docker Desktop and retry." >&2
    exit 1
  fi
fi

# The macOS app does not put its CLI on PATH.
tailscale_bin="$(tailscale_path)"
if [[ ! -x "$tailscale_bin" ]]; then
  echo "Tailscale is not installed." >&2
  if [[ -d "/Applications/Self Service.app" ]]; then
    echo "Install it from Jamf Self Service: open -a 'Self Service'" >&2
  fi
  exit 1
fi

if ! "$tailscale_bin" status >/dev/null 2>&1; then
  echo "Tailscale is not connected. Run 'tailscale up' and retry." >&2
  exit 1
fi

export SPLUNK_HOST="${SPLUNK_HOST:-splunkazure-api-azure-eastus.octoca.ts.net}"
export SPLUNK_PORT=443
export SPLUNK_SCHEME=https
export VERIFY_SSL=true
export FASTMCP_LOG_LEVEL=INFO

docker_args=(run -i --rm)
if [[ -n "${CODESPACES:-}" ]]; then
  docker_args+=(--dns=100.100.100.100)
fi

exec docker "${docker_args[@]}" \
  -e SPLUNK_HOST \
  -e SPLUNK_PORT \
  -e SPLUNK_BEARER_TOKEN \
  -e SPLUNK_SCHEME \
  -e VERIFY_SSL \
  -e FASTMCP_LOG_LEVEL \
  "$IMAGE"
